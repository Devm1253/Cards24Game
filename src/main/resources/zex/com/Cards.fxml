<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<VBox alignment="CENTER" prefHeight="650.0" prefWidth="694.0" spacing="20.0" styleClass="game-container" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="zex.com.Card24Controller">

    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <children>

        <!-- Title -->
        <Label styleClass="game-title" text="CARD 24" />

        <!-- Instructions -->
        <Label styleClass="subtitle" text="Use all four cards to make 24" />

        <!-- Divider -->
        <Line endX="250" startX="-250" styleClass="divider" />

        <!-- Playing Cards -->
        <HBox alignment="CENTER" spacing="15" styleClass="cards-container">
            <children>
                <ImageView fx:id="card1" fitHeight="160" fitWidth="110" preserveRatio="true" />
                <ImageView fx:id="card2" fitHeight="160" fitWidth="110" preserveRatio="true" />
                <ImageView fx:id="card3" fitHeight="160" fitWidth="110" preserveRatio="true" />
                <ImageView fx:id="card4" fitHeight="160" fitWidth="110" preserveRatio="true" />
            </children>
        </HBox>

        <Label styleClass="expression-label" text="Enter an expression using each card once" />


        <TextField fx:id="textField" maxWidth="450" prefHeight="45" styleClass="expression-field" />


        <HBox alignment="CENTER" spacing="15">
            <children>
                <Button onAction="#handleVerify" styleClass="verify-button" text="Verify" />

                <Button onAction="#handleRefresh" styleClass="refresh-button" text="Refresh" />
            </children>
        </HBox>

    </children>
</VBox>
